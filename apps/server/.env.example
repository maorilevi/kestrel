# Control plane
PORT=4000
# Where the web app is served from (CORS + trusted origin for auth).
WEB_ORIGIN=http://localhost:3000
# Public URL of this server, used by Better Auth for callbacks.
BETTER_AUTH_URL=http://localhost:4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# sqlite file path (default ./data/kestrel.db) or a postgres:// URL.
DATABASE_URL=

# Sandboxes: "local" (no isolation, development only) or "e2b".
SANDBOX_PROVIDER=local
E2B_API_KEY=
E2B_TEMPLATE=base

# Architecture chat and coding agent (Anthropic API)
ANTHROPIC_API_KEY=
KESTREL_CHAT_MODEL=claude-opus-5
KESTREL_AGENT_MODEL=claude-opus-5
# low | medium | high | xhigh | max - xhigh is the recommended level for coding work.
KESTREL_AGENT_EFFORT=xhigh
